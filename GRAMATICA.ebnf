programa        = { ";" | instrucao } ;
instrucao       = declaracao | atribuicao | escrita | leitura | condicional | repeticao | interrupcao ;
declaracao      = ("POKER_FACE" | "TRUE_STORY") tipo identificador "=" expressao ";" ;
tipo            = "OVER_9000" | "ME_GUSTA" | "FUCK_YEAH" ;
atribuicao      = identificador "=" expressao ";" ;
escrita         = "CEREAL_GUY" ["("] expressao [")"] ";" ;
leitura         = "ASK_ME_ANYTHING" ["("] identificador [")"] ";" ;
condicional     = "DERP" "(" expressao ")" bloco ["I_LIED" (bloco | condicional)] ;
repeticao       = "FOREVER_ALONE" "(" expressao ")" bloco ;
interrupcao     = "BREAK" ";" ;
bloco           = "{" { ";" | instrucao } "}" ;
expressao       = disjuncao ;
disjuncao       = conjuncao { "||" conjuncao } ;
conjuncao       = igualdade { "&&" igualdade } ;
igualdade       = comparacao { ("==" | "!=") comparacao } ;
comparacao      = soma { (">" | ">=" | "<" | "<=") soma } ;
soma            = produto { ("+" | "-") produto } ;
produto         = unaria { ("*" | "/") unaria } ;
unaria          = ("!" | "-") unaria | primaria ;
primaria        = inteiro | texto | booleano | identificador | "(" expressao ")" ;
booleano        = "VERDADEIRO" | "NO_GUY" ;
(* Existem sinônimos em português na tabela de palavras-chave do lexer. *)
(* NOT_BAD é reservado, mas funções/retorno ainda não são implementados. *)
